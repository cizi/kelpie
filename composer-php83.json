{
	"name": "nette/sandbox",
	"description": "The sandbox is a pre-packaged Nette Framework project, basic configured structure for your application.",
	"homepage": "https://nette.org",
	"type": "project",
	"license": ["BSD-3-Clause", "GPL-2.0", "GPL-3.0"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		},
		{
			"name": "Nette Community",
			"homepage": "https://nette.org/contributors"
		}
	],
	"require": {
		"php": "^8.3",
		"nette/application": "^3.2",
		"nette/bootstrap": "^3.2",
		"nette/caching": "^3.2",
		"nette/database": "^3.2",
		"nette/di": "^3.2",
		"nette/forms": "^3.2",
		"nette/http": "^3.2",
		"nette/mail": "^3.1",
		"nette/security": "^3.2",
		"nette/utils": "^4.0",
		"nette/robot-loader": "^4.0",
		"nette/finder": "^3.0",
		"nette/safe-stream": "^2.3",
		"latte/latte": "^3.0",
		"tracy/tracy": "^2.10",
		"dg/adminer-custom": "~1.6",
	  	"php-gettext/php-gettext" : "1.0.*",
		"dibi/dibi" : "^4",
		"joseki/pdf-response": ">= 2.1",
		"phpmailer/phpmailer": "^6.2",
      	"symfony/polyfill-mbstring": "^1.2"
	},
	"require-dev": {
		"nette/tester": "~2.2"
	},
  	"repositories": [
	{
	  "type": "package",
	  "package": {
		"name": "php-gettext/php-gettext",
		"version": "1.0.11",
		"dist": {
		  "type": "tar",
		  "url": "https://web.archive.org/web/20240805104653id_/https://launchpadlibrarian.net/61225817/php-gettext-1.0.11.tar.gz"
		},
		"autoload": {
		  "classmap": [
			"gettext.php",
			"streams.php"
		  ]
		}
	  }
	}
  ],
	"config": {
		"preferred-install": "dist"
	}
}
